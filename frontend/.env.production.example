# BusTrackSystem Production Frontend Environment Variables
# Configure these in your Vercel Project Dashboard (Settings -> Environment Variables)

# 1. Base URL of your deployed backend service (e.g. on Railway, Render, or ECS)
VITE_API_URL=https://your-bustrack-backend.up.railway.app

# 2. WebSocket URL for real-time fleet telemetry broadcasts
VITE_WS_URL=wss://your-bustrack-backend.up.railway.app
