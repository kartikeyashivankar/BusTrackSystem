# BusTrackSystem Production Backend Environment Variables
# Configure these in your Railway / Render Project Settings

NODE_ENV=production
PORT=5000

# MongoDB Atlas cluster connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bustrack?retryWrites=true&w=majority

# Strong random secret key used for signing JWT authentication tokens
JWT_SECRET=bustrack_jwt_production_secure_token_2026

# Allowed frontend client origins (supports multiple comma-separated domains)
CLIENT_URL=https://your-bustrack-app.vercel.app,http://localhost:5173

# ESP32 Serial Hardware Configuration
# Note: In cloud environments where no physical COM port is attached,
# the backend gracefully activates simulation mode and hardware simulation APIs.
SERIAL_PORT=COM3
BAUD_RATE=115200
